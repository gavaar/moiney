{
  "name": "moiney",
  "version": "0.6.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "convex:dev": "bunx convex dev",
    "convex:deploy": "bun run verify && bunx convex deploy",
    "convex:refresh": "bash scripts/convex-refresh.sh",
    "benchmark:performance": "bun run benchmarks/update15-performance.ts",
    "lint": "expo lint",
    "test": "BUN_JSC_useFTLJIT=false vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "bun run lint && bun run test && bun run typecheck"
  },
  "dependencies": {
    "@convex-dev/migrations": "^0.3.7",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "convex": "1.46.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "nativewind": "~4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~58.0.0",
    "convex-test": "0.0.60",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-native-screens": "~4.30.0"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13.0"
  }
}
